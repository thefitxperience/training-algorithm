      "Beginner": {
        "maxSkill": 1,
        "why": "The easiest rung open to a beginner."
      },
      "Intermediate": {
        "maxSkill": 2,
        "why": "The hardest rung a beginner is offered, so the first weeks are about owning it."
      },
      "Advanced": {
        "maxSkill": 3,
        "why": "The hardest intermediate rung, not the top of the ladder: nobody starts on a full planche because their level says Advanced."
      }
    },
