{
  "note": "Training styles beyond the gym (source/UDRA-new-modality-exercises_1.xlsx, imported by scripts/importModalities.ts). This file is the app's own: how each style builds a session, which styles combine and how, and the defaults a coach can tune. Gym-only programs are untouched by it.",
  "modalities": {
    "Gym": {
      "template": "strength",
      "label": "Gym",
      "why": "The generator as it is: sub-region volume, the one-hour rules, every assessment layer."
    },
    "Calisthenics": {
      "template": "strength",
      "label": "Calisthenics",
      "ladders": true,
      "why": "The same volume model on the calisthenics pool, with a rung per progression ladder per client and the skill work first."
    },
    "CrossFit": {
      "template": "crossfit",
      "label": "CrossFit",
      "why": "A strength part (the generator, on the CrossFit pool, no metcon moves) and a metcon to finish, which the hour is fitted around."
    },
    "Mat Pilates": {
      "template": "pilates",
      "apparatus": [
        "mat"
      ],
      "label": "Mat Pilates",
      "why": "Not sets and rest: an ordered flow in the classical order, a few reps of each, timed to the hour."
    },
    "Reformer Pilates": {
      "template": "pilates",
      "apparatus": [
        "reformer"
      ],
      "label": "Reformer Pilates",
      "why": "The reformer's classical order by section, springs by section, reps per move, timed to the hour."
    }
  },
  "levelRule": {
    "why": "The sheet's rule 1 for its own exercises: skill 1-2 opens at Beginner, 3 at Intermediate, 4-5 at Advanced. Stricter than the gym library's (Intermediate there reaches skill 4), because these are skills, not loads: a level must own them.",
    "maxSkill": {
      "Beginner": 2,
      "Intermediate": 3,
      "Advanced": 5
    }
  },
  "strengthExcludeTags": [
    "Metcon",
    "Conditioning",
    "Plyometric"
  ],
  "strengthExcludeWhy": "Metcon and engine moves (burpees, wall balls, the rower, box jumps) are never a strength slot in any style: they belong to the metcon or the conditioning.",
  "bodyweightStrengthReps": "5-8",
  "bodyweightStrengthWhy": "Get Stronger on an unloaded exercise is not 3-5 reps: strength there comes from the harder rung, so the reps sit at 5-8.",
